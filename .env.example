# ==============================================================================
# lingro-rag-service environment template
#
# 用法：复制为 .env 后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，请勿提交任何真实密钥。
#
# APP_ENV=local 时缺少变量只会告警，服务可以启动；
# APP_ENV=dev / prod（或 STRICT_ENV_VALIDATION=true）时缺少变量会直接退出。
# ==============================================================================

APP_ENV=local
# STRICT_ENV_VALIDATION=true

# ------------------------------------------------------------------------------
# 中间件根地址：MySQL / Redis / Neo4j 未单独配置时默认使用该地址
# ------------------------------------------------------------------------------
REMOTE_MIDDLEWARE_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# MySQL：会话状态与业务配置
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=llb
MYSQL_USER=lingro
MYSQL_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Redis：索引构建任务队列（FIFO）
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 无 Redis 时可设为 false，跳过索引任务调度器
ENABLE_INDEX_SCHEDULER=true

# ------------------------------------------------------------------------------
# Neo4j：HippoRAG 知识图谱存储
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Elasticsearch：全文 / 向量混合检索（dense_vector 维度需 <= 4096）
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=No-Key-Required

# ------------------------------------------------------------------------------
# 上游 Java 微服务（计费、额度、知识库版本通知、网页检索等）
# 未配置时回落到 localhost 占位地址，相关功能会失败但不影响启动
# ------------------------------------------------------------------------------
MICRO_LLM_BACKEND_CORE_BASE_URL=http://127.0.0.1:11600
MICRO_LLM_BACKEND_WEBSEARCH_ENGINE_BASE_URL=http://127.0.0.1:11800
MICRO_LLM_BACKEND_PAYMENT_ORDER_BASE_URL=http://127.0.0.1:11900
MICRO_LLM_BACKEND_USER_BASE_URL=http://127.0.0.1:11750

# ------------------------------------------------------------------------------
# 模型供应商（按需填写，未使用的留空即可）
# ------------------------------------------------------------------------------
QWEN_SERIES_API_KEY=
OPEN_ROUTER_API_KEY=
DEEPSEEK_API_KEY=
GLM_4_PLUS_API_KEY=

# 可选：覆盖各供应商的 OpenAI 兼容入口
# QWEN_PLUS_CHAT_COMPLETIONS_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPEN_ROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1
# DEEPSEEK_CHAT_COMPLETIONS_URL=https://api.deepseek.com
# GLM_4_PLUS_CHAT_COMPLETIONS_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ------------------------------------------------------------------------------
# Embedding 服务（OpenAI 兼容接口）
# ------------------------------------------------------------------------------
EMBEDDING_API_BASE=http://127.0.0.1:48077/v1
EMBEDDING_API_KEY=No-Key-Required
# DEFAULT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_001_BATCH_SIZE=2
# EMBEDDING_001_MAX_RETRIES=1

# 网页检索多路 embedding 的采样权重
WEB_SEARCH_EMBEDDING_MODEL_WEIGHT_001=1.0
WEB_SEARCH_EMBEDDING_MODEL_WEIGHT_002=0.0
WEB_SEARCH_EMBEDDING_MODEL_WEIGHT_003=0.0

# ------------------------------------------------------------------------------
# 存储卷（容器内路径，对应 Dockerfile VOLUME）
# ------------------------------------------------------------------------------
VS_ROOT_PATH=/vector_store
CACHE_ROOT_PATH=/tmp/cache
BASE_PROMPT_TEMPLATE_PATH=/prompt_templates
# LOG_FILE_DIR=/tmp/logs
NLTK_DATA_PATH=/usr/local/share/nltk_data

# ------------------------------------------------------------------------------
# Agent 与上下文
# ------------------------------------------------------------------------------
DEFAULT_CONTEXT_TOKENS_LIMIT=6000
AGENT_MAX_EXECUTION_TIME=300
AGENT_MAX_ITERATIONS=20

# ------------------------------------------------------------------------------
# 出站代理（OpenRouter / Wikipedia 等，按需配置）
# ------------------------------------------------------------------------------
# VPN_PROXY_URL=http://127.0.0.1:1080
# WIKIPEDIA_HTTP_PROXY=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# MCP 托管服务的 OAuth2 client credentials
# ------------------------------------------------------------------------------
LINGRO_LANGCHAIN_PY_CLIENT_SECRET=change-me
# AAD_CLIENT_ID=lingro-rag-service

# ------------------------------------------------------------------------------
# HTTP
# ------------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=*
SERVER_TIMEZONE=Asia/Shanghai
